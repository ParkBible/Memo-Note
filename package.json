{
  "name": "memo-note",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,blue \"vite\" \"tsx watch --clear-screen=false server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && tsc --noEmit -p server && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "dexie": "^4.4.7",
    "hono": "^4.13.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.21"
  }
}
