# ── 구글 로그인 · 드라이브 동기화 ─────────────────────────────
# 비워 두면 로그인·동기화가 꺼지고 메모는 이 브라우저에만 저장된다.
# Park-Hub 에서 백업 상태를 보려면 Park-Hub·노벨벙커·레시피노트와 같은 OAuth 클라이언트를 써야 한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 로그인할 수 있는 구글 계정 (쉼표로 여러 개)
ALLOWED_EMAILS=
# 로그인 쿠키 서명용 임의 문자열. 예: openssl rand -base64 32
SESSION_SECRET=
# 로그인 콜백 기준 주소. 비우면 요청 주소로 정한다 (로컬 개발은 http://localhost:5182)
APP_ORIGIN=

# 로컬 API 서버 포트 (Vite 가 /api 를 여기로 프록시한다). 배포 환경이 PORT 를 주면 그걸 쓴다
API_PORT=8790
